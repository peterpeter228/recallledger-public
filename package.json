{
  "name": "recallledger",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --import tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "build:web": "vite build",
    "build": "tsc --noEmit && pnpm run build:recorded && vite build && pnpm run build:server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run tests/domain",
    "test:integration": "vitest run tests/server tests/adapters",
    "doctor": "node --import tsx scripts/doctor.ts",
    "eval:fixtures": "node --import tsx scripts/evaluate.ts",
    "eval:ablation": "node --import tsx scripts/evaluate.ts --ablation",
    "verify:offline": "pnpm typecheck && pnpm build:web && pnpm test && pnpm eval:fixtures",
    "dev": "node --import tsx src/server/main.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "verify:live": "node --import tsx scripts/verify-live.ts",
    "verify:restore": "node --import tsx scripts/restore.ts",
    "verify-count": "node --import tsx scripts/verify-count.ts",
    "memory:seed": "node --import tsx scripts/seed.ts",
    "evidence:export": "node --import tsx scripts/evaluate.ts",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/main.js",
    "build:recorded": "node --import tsx scripts/build-recorded.ts",
    "memory:freeze": "node --import tsx scripts/freeze.ts",
    "test:e2e": "node tests/e2e/browser-acceptance.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@mysten-incubation/memwal": "0.1.9",
    "@mysten/seal": "1.5.1",
    "@mysten/sui": "2.37.0",
    "@noble/hashes": "2.4.0",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "canonicalize": "5.1.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
