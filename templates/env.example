# Specification template. Copy only after app scripts/config validators exist.
# No real values are included; secrets stay server-side.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Render: HOST=0.0.0.0; Vite dev: APP_BASE_URL=http://localhost:5173
APP_BASE_URL=http://localhost:3000
DATABASE_URL=
SESSION_SECRET=
OPERATOR_BOOTSTRAP_SECRET=

# Tatum business reads. Never VITE_/NEXT_PUBLIC_ prefix these values.
TATUM_API_KEY=
# Explicit observed asset; no assumed decimals or simple PTB transfer semantics.
OBSERVATION_COIN_TYPE=
TATUM_SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
TATUM_READ_CONCURRENCY=2
TATUM_READ_TIMEOUT_MS=10000
TATUM_MAX_RETRIES=3

# MemWal managed relayer. SDK config/transport verified by doctor.
MEMWAL_OWNER_ADDRESS=
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_AGENT_PUBLIC_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=recallledger-demo-v1
MEMWAL_CREDS_DIR=

# Disabled until this scope and its write cost/data have authorization.
ALLOW_MAINNET_MEMORY_WRITES=false
# Attest complete owner upload inventory, including orphan/old namespace uploads.
MEMWAL_OWNER_HISTORY_CONFIRMED=false
MAINNET_MEMORY_WRITE_LIMIT=20
OWNER_MEMORY_INVENTORY_LIMIT=40
PUBLIC_DEMO_READ_ONLY=true
PUBLIC_DEMO_MANIFEST_VERSION=

# App runtime model API: independent of the dot/ChatGPT subscription.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_CALLS_PER_SESSION=3

# Not needed by this project: wallet mnemonic, SUI_PRIVATE_KEY, payment signer.

# DB scopes.memory_account_id is legacy-named: stores expected receipt owner address,
# not MEMWAL_ACCOUNT_ID. Both runtime config values are required and distinct.
# LLM_BASE_URL is a full HTTPS chat/completions endpoint, not a base-only URL.

# Same fixed scope for server, seed and portable-manifest freeze.
OPERATOR_SCOPE=demo-recallledger
